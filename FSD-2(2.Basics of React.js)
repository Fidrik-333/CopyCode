d. Conditionally Render a Component in the Browser
Aim:
To render content conditionally using the ternary operator in React.
Program:
ConditionalRender.js
import React, { useState } from 'react';

function ConditionalRender() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);

  return (
    <div>
      {isLoggedIn ? (
        <h2>Welcome Back!</h2>
      ) : (
        <h2>Please Log In</h2>
      )}

      <button onClick={() => setIsLoggedIn(!isLoggedIn)}>
        {isLoggedIn ? 'Logout' : 'Login'}
      </button>
    </div>
  );
}

export default ConditionalRender;
Output:
Initially:
Please Log In
[Login]

After clicking Login:
Welcome Back!
[Logout]






e. Display Text Using String Literals
Aim:
To use string literals (template literals) for displaying dynamic content.
Program:
StringLiteral.js
import React from 'react';

function StringLiteral() {
  const name = 'React Developer';
  const task = 'learning React';

  return (
    <div>
      <h2>{`Hello, ${name}!`}</h2>
      <p>{`You're currently ${task}.`}</p>
    </div>
  );
}

export default StringLiteral;
Output:
Hello, React Developer!
