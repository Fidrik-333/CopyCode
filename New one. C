#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_SYMBOLS 100
#define MAX_LINE_LEN 100
#define MAX_OPCODE_LEN 10

typedef struct {
    char label[20];
    int address;
} Symbol;

typedef struct {
    char mnemonic[10];
    char opcode[3];
} OpCode;

Symbol symtab[MAX_SYMBOLS];
int symcount = 0;
int locctr = 0;

// Opcode table initialization
OpCode optab[] = {
    {"MOV", "01"},
    {"ADD", "02"},
    {"SUB", "03"},
    {"END", "00"}
};

char* get_opcode(char *mnemonic) {
    for (int i = 0; i < sizeof(optab)/sizeof(optab[0]); i++) {
        if (strcmp(mnemonic, optab[i].mnemonic) == 0)
            return optab[i].opcode;
    }
    return NULL;
}

void insert_symbol(char *label, int address) {
    for (int i = 0; i < symcount; i++) {
        if (strcmp(symtab[i].label, label) == 0) {
            printf("Error: Duplicate symbol %s\n", label);
            exit(1);
        }
    }
    strcpy(symtab[symcount].label, label);
    symtab[symcount].address = address;
    symcount++;
}

int search_symbol(char *label) {
    for (int i = 0; i < symcount; i++) {
        if (strcmp(symtab[i].label, label) == 0)
            return symtab[i].address;
    }
    return -1;
}

// Pass 1: Build symbol table and locate instructions
void pass1(FILE *source) {
    char line[MAX_LINE_LEN];

    while (fgets(line, MAX_LINE_LEN, source)) {
        char label[20] = "", opcode[20] = "", operand[20] = "";
        
        sscanf(line, "%s %s %s", label, opcode, operand);

        if (label[strlen(label) - 1] == ':') {
            label[strlen(label) - 1] = '\0'; // Remove ':'
            insert_symbol(label, locctr);
            // Shift opcode & operand since label was present
            strcpy(opcode, operand);
            operand[0] = '\0';
            sscanf(line, "%*s %s %s", opcode, operand);
        } else {
            // If no label, first token is opcode
            strcpy(operand, opcode);
            strcpy(opcode, label);
            label[0] = '\0';
        }

        if (strcmp(opcode, "END") == 0)
            break;

        char *op = get_opcode(opcode);
        if (op != NULL) {
            locctr += 1; // Assume each instruction is 1 word
        } else {
            printf("Error: Invalid opcode %s\n", opcode);
            exit(1);
        }
    }
    rewind(source);
}

// Pass 2: Generate machine code using symbol table
void pass2(FILE *source, FILE *output) {
    char line[MAX_LINE_LEN];

    fprintf(output, "LOC\tLABEL\tOPCODE\tOPERAND\tMACHINE_CODE\n");
    int address = 0;

    while (fgets(line, MAX_LINE_LEN, source)) {
        char label[20] = "", opcode[20] = "", operand[20] = "";
        
        sscanf(line, "%s %s %s", label, opcode, operand);

        if (label[strlen(label) - 1] == ':') {
            label[strlen(label) - 1] = '\0';
            sscanf(line, "%*s %s %s", opcode, operand);
        } else {
            strcpy(operand, opcode);
            strcpy(opcode, label);
            label[0] = '\0';
        }

        if (strcmp(opcode, "END") == 0)
            break;

        char *op = get_opcode(opcode);
        if (op != NULL) {
            int operand_address = -1;
            if (strlen(operand) > 0) {
                operand_address = search_symbol(operand);
            }

            if (operand_address == -1 && strlen(operand) > 0) {
                printf("Error: Undefined symbol %s\n", operand);
                exit(1);
            }

            fprintf(output, "%d\t%s\t%s\t%s\t%s%02d\n",
                    address,
                    label[0] != '\0' ? label : "-",
                    opcode,
                    strlen(operand) > 0 ? operand : "-",
                    op,
                    operand_address == -1 ? 0 : operand_address);
            address++;
        }
    }
}

int main() {
    FILE *source = fopen("source.asm", "r");
    if (!source) {
        printf("Error: Cannot open source file\n");
        return 1;
    }

    pass1(source);

    FILE *output = fopen("output.obj", "w");
    pass2(source, output);

    fclose(source);
    fclose(output);

    printf("Two-pass assembler completed. Output saved in output.obj\n");
    return 0;
}


