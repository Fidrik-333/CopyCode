AIM :- To write and execute a simple Prolog program that demonstrates family relationships using facts, rules, and queries.  
​CODE


code :-

% Facts
male(john).
male(mike).
male(tom).
female(lisa).
female(anna).
female(susan).

parent(john, mike). % John is parent of Mike
parent(john, lisa).
parent(lisa, tom).
parent(lisa, anna).
parent(mike, susan).

% Rules
% X is a father of Y if X is male and X is a parent of Y
father(X, Y) :- male(X), parent(X, Y).

% X is a mother of Y if X is female and X is a parent of Y
mother(X, Y) :- female(X), parent(X, Y).

% X is a grandparent of Y if X is a parent of Z and Z is a parent of Y
grandparent(X, Y) :- parent(X, Z), parent(Z, Y).

% X is a sibling of Y if they share at least one parent and are not the same person
sibling(X, Y) :- parent(Z, X), parent(Z, Y), X \= Y.



output:-
?- father(john, mike).
true.

?- mother(lisa, tom).
true.

?- grandparent(john, tom).
true.

?- sibling(tom, anna).
true.

?- sibling(mike, lisa).
true.
