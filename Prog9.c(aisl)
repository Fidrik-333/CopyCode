#!/bin/bash

echo "Current top running processes:"
ps aux | head -5

echo "Enter process name to find (e.g., bash, sleep):"
read pname

echo "Matching processes:"
pgrep -l "$pname"

echo "Live system resource usage (press q to quit):"
top -b -n 1 | head -15



