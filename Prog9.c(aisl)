#!/bin/bash

echo "Enter a filename to create:"
read fname

echo "Enter content to write into the file:"
read content

echo "$content" > "$fname"

echo "File '$fname' created."

echo "Listing all files:"
ls -l

echo "Copying $fname to copy_of_$fname"
cp "$fname" "copy_of_$fname"

ls -l "copy_of_$fname"

echo "Renaming copy_of_$fname to renamed_$fname"
mv "copy_of_$fname" "renamed_$fname"

ls -l "renamed_$fname"

echo "Deleting renamed_$fname"
rm "renamed_$fname"

echo "File deleted. Current files:"
ls -l




